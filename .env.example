# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Database Configuration
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_NAME=ahp_db

# Security
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-change-this

# Backend Configuration
SERVER_PORT=9000
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DE_X132_AHP=DEBUG
DDL_AUTO=validate
SPRING_PROFILE=docker

# API Configuration
API_URL=http://localhost:9000
NODE_ENV=production

# Mail Configuration (optional - defaults to localhost:1025 for development)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@example.com
# MAIL_PASSWORD=your_mail_password
# MAIL_FROM=noreply@example.com

# Frontend Configuration
FRONTEND_URL=http://localhost:8080

# Activation Token Configuration
TOKEN_EXPIRY_HOURS=24

# Mail Configuration (Production - configure for real SMTP server)
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@your-domain.com

# For Development with MailHog (docker-compose.dev.yml):
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# APP_MAIL_FROM=noreply@ahp-dev.local
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# Logging
LOG_LEVEL=INFO
